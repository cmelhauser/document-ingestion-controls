FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8080 \
    LOG_LEVEL=info

WORKDIR /app

COPY requirements-sidecar.txt ./
RUN pip install --no-cache-dir -r requirements-sidecar.txt

COPY scripts/ ./scripts/

EXPOSE 8080

# Use the Python entrypoint so HOST/PORT/LOG_LEVEL from the ECS task are honored.
# The CRM task sets PORT=8081 and RETRIEVAL_BASE_URL=http://127.0.0.1:8081.
CMD ["python", "scripts/retrieval_sidecar.py"]
