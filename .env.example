# Business Document Ingestion local configuration
#
# Copy this file to .env, enter only approved provider keys, and keep .env private.
# .env is ignored by Git. Do not place secrets in manifests, handoffs, source PDFs,
# or output artifacts. Shell/CI/secret-manager values override .env, and explicit
# command-line options override both.
#
# Every repository command that reads configuration loads this root .env when it
# starts. A process that exports BUSINESS_DOCUMENT_IGNORE_PROJECT_ENV as true
# skips it; that switch cannot be set from inside this file. Keep document paths,
# output paths, and client-specific inputs on the command line.

# Optional default provider for the separate extraction lane in
# scripts/llm_adapter.py. Named consensus and reasoning lanes use the explicit
# LLM_CONSENSUS_* and LLM_REASONING_* settings below. It is not deprecated: omit
# it only when the extraction lane should use its documented OpenAI default.
# supported-llm-providers: anthropic, google, openai, openrouter
# Select one provider: anthropic, google, openai, or openrouter. The
# selected provider's model is read from its matching provider-specific setting.
# The selected provider's raw
# responses remain review-only proposal evidence and are never final decisions.
LLM_EXTRACT_PROVIDER=openai
# Shared retry policy. When true, a recognized account/model quota response
# opens a process-local provider circuit and prevents wasted follow-up calls;
# unsent work remains an explicit provider exception. Set false only for an
# approved run that must continue after quota signals.
LLM_FAIL_FAST_ON_PROVIDER_QUOTA=true
# Source-family routing hint for the run-level extraction lane. Use auto for
# mixed/unfamiliar corpora; select commission_statement or commission_report only
# after the retained corpus has been verified.
LLM_DOCUMENT_FAMILY=auto
# Path to a corpus-context file built by scripts/extraction_context.py. Empty means
# no context. Both extraction lanes must point at the same file: consensus.py refuses
# lanes conditioned by different notes.
LLM_CORPUS_CONTEXT=

# Named lane routing. Run scripts/llm_adapter.py twice with --lane
# consensus_primary and --lane consensus_secondary to create genuinely
# independent engine artifacts before invoking scripts/consensus.py. The
# reasoning lane is used by the client-review and full-dataset proposal agents.
LLM_CONSENSUS_PRI_PROVIDER=openai
LLM_CONSENSUS_SEC_PROVIDER=google
LLM_CONSENSUS_TIE_PROVIDER=
LLM_REASONING_PROVIDER=openai
GOOGLE_VERTEX_AI_CONSENSUS_MODEL=gemini-2.5-flash
GOOGLE_VERTEX_AI_REASONING_MODEL=gemini-2.5-pro
OPENAI_CONSENSUS_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-luna
OPENROUTER_CONSENSUS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenAI Responses adapter (disabled until OPENAI_API_KEY is populated and invoked).
OPENAI_API_KEY=
OPENAI_CREDENTIAL_ENV=OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_INPUT_MODE=auto
OPENAI_MAX_PAGES=1000
OPENAI_MAX_PDF_BYTES=10000000
OPENAI_MAX_TEXT_CHARS=100000
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=2
OPENAI_MAX_WORKERS=8
OPENAI_RETRY_BACKOFF_SECONDS=1
OPENAI_MAX_BACKOFF_SECONDS=120
OPENAI_RATE_LIMIT_REQUESTS_PER_MINUTE=500
OPENAI_RATE_LIMIT_TOKENS_PER_MINUTE=2000000
OPENAI_MAX_REQUEST_TOKENS=550000
OPENAI_OUTPUT_TOKEN_RESERVE=4096

# Google Gemini through Vertex AI. The Google Gen AI SDK uses Application
# Default Credentials (ADC) with vertexai=True, so billing is charged to this
# project. GOOGLE_APPLICATION_CREDENTIALS, when used, must point outside this
# repository; gcloud or workload-identity ADC is preferred. Do not place a
# service-account JSON value in this file.
# Optional external ADC file path. Keep the file outside this repository; leave
# blank when gcloud/workload-identity ADC is being used.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_AI_PROJECT_ID=
GOOGLE_VERTEX_AI_LOCATION=us-central1
GOOGLE_VERTEX_AI_MODEL=gemini-2.5-pro
GOOGLE_VERTEX_AI_CREDENTIAL_ENV=GOOGLE_APPLICATION_CREDENTIALS
# Gemini 2.5 Pro Vertex hard limits, recorded separately from the operational
# safety caps below: 1,048,576 context tokens, 65,536 output tokens, and a
# 500 MB request payload. Vertex permits 3,000 files/request but only 1,000
# pages/PDF and 50 MB/API-uploaded file.
# The operational caps are checked against these before a Google run starts, so a
# cap set above what the model accepts is refused up front instead of failing at
# the provider partway through. MAX_PAGES_PER_FILE is a recorded fact only:
# intake bursts every source into one-page masters, so a submitted file always
# carries exactly one page.
GOOGLE_VERTEX_AI_MODEL_CONTEXT_TOKENS=1048576
GOOGLE_VERTEX_AI_MODEL_MAX_OUTPUT_TOKENS=65536
GOOGLE_VERTEX_AI_MODEL_MAX_INPUT_BYTES=524288000
GOOGLE_VERTEX_AI_MODEL_MAX_FILES_PER_REQUEST=3000
GOOGLE_VERTEX_AI_MODEL_MAX_PAGES_PER_FILE=1000
GOOGLE_VERTEX_AI_MODEL_MAX_FILE_BYTES=50000000
GOOGLE_VERTEX_AI_INPUT_MODE=auto
GOOGLE_VERTEX_AI_MAX_PAGES=1000
GOOGLE_VERTEX_AI_MAX_PDF_BYTES=10000000
GOOGLE_VERTEX_AI_MAX_TEXT_CHARS=100000
GOOGLE_VERTEX_AI_TIMEOUT_SECONDS=180
GOOGLE_VERTEX_AI_MAX_RETRIES=4
GOOGLE_VERTEX_AI_MAX_WORKERS=8
GOOGLE_VERTEX_AI_RETRY_BACKOFF_SECONDS=1
GOOGLE_VERTEX_AI_MAX_BACKOFF_SECONDS=120
GOOGLE_VERTEX_AI_RATE_LIMIT_REQUESTS_PER_MINUTE=12
GOOGLE_VERTEX_AI_RATE_LIMIT_TOKENS_PER_MINUTE=80000
# Keep a request below 200k input tokens to avoid Gemini 2.5 Pro long-context
# pricing/throughput behavior. This is an operational cap, not the model limit.
GOOGLE_VERTEX_AI_MAX_REQUEST_TOKENS=55000
GOOGLE_VERTEX_AI_OUTPUT_TOKEN_RESERVE=8192

# OpenRouter (disabled until OPENROUTER_API_KEY is populated and selected for
# a lane). It uses the OpenAI SDK only as an HTTP client against the separate
# OpenRouter Chat Completions endpoint; it does not share OpenAI credentials.
# Native text is the safe default because PDF/file support varies by routed
# model. Pages without usable native text fail closed into review.
OPENROUTER_API_KEY=
OPENROUTER_CREDENTIAL_ENV=OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Anthropic is its own provider boundary and its own vendor for consensus
# independence: an Anthropic lane is genuinely independent of an OpenAI, Google,
# or routed lane, with no routing to see through. Structured output comes from a
# required tool call whose input_schema is the extraction schema, because the
# Messages API has no strict response_format. A retained page PDF is sent as a
# document block, so the recorded vendor is the one that read the glyphs.
ANTHROPIC_API_KEY=
ANTHROPIC_CREDENTIAL_ENV=ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_CONSENSUS_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_REASONING_MODEL=claude-haiku-4-5-20251001
# The Messages API requires an explicit output ceiling and has no server
# default. A page of dense table rows needs headroom: a truncated response is
# indistinguishable from a model that read fewer rows than the page holds.
ANTHROPIC_MAX_OUTPUT_TOKENS=16384
ANTHROPIC_INPUT_MODE=pdf
ANTHROPIC_MAX_BACKOFF_SECONDS=120.0
ANTHROPIC_MAX_PAGES=1000
ANTHROPIC_MAX_PDF_BYTES=10000000
ANTHROPIC_MAX_REQUEST_TOKENS=80000
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_OUTPUT_TOKEN_RESERVE=4096
ANTHROPIC_RATE_LIMIT_REQUESTS_PER_MINUTE=60
ANTHROPIC_RATE_LIMIT_TOKENS_PER_MINUTE=100000
ANTHROPIC_MAX_TEXT_CHARS=100000
ANTHROPIC_MAX_WORKERS=8
ANTHROPIC_REASONING_EFFORT=medium
ANTHROPIC_RETRY_BACKOFF_SECONDS=1.0
ANTHROPIC_THINKING_MODE=
ANTHROPIC_TIMEOUT_SECONDS=120
# OpenRouter reads a retained page PDF only on a model that accepts files
# natively. The adapter verifies this against OpenRouter's own model catalogue
# (architecture.input_modalities contains "file") before any page is sent, pins
# the file-parser engine to "native", and refuses otherwise. Left to its default
# OpenRouter would OCR the PDF with another vendor's engine and hand the text to
# the routed model, which would record the wrong vendor as having read the page
# and could put two "independent" lanes on one shared OCR pass.
# A text-only model is still fine for the reasoning and review lanes, which send
# JSON packets rather than pages.
OPENROUTER_INPUT_MODE=text
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_IMAGE_DPI=200
OPENROUTER_MAX_PAGES=1000
OPENROUTER_MAX_PDF_BYTES=10000000
OPENROUTER_MAX_TEXT_CHARS=100000
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_WORKERS=8
OPENROUTER_RETRY_BACKOFF_SECONDS=1
OPENROUTER_MAX_BACKOFF_SECONDS=120
OPENROUTER_RATE_LIMIT_REQUESTS_PER_MINUTE=60
OPENROUTER_RATE_LIMIT_TOKENS_PER_MINUTE=100000
OPENROUTER_MAX_REQUEST_TOKENS=75000
OPENROUTER_OUTPUT_TOKEN_RESERVE=4096
OPENROUTER_REASONING_EFFORT=medium

# Content-addressed provider-response cache; never a canonical-facts store.
# Set only by scripts/run_workspace.py run for a contained live run. Leave
# blank in local configuration; a non-empty value names that run's root.
BUSINESS_DOC_RUN_ROOT=
LLM_CACHE_DIR=.llm-cache
LLM_TOKEN_ESTIMATE_SAFETY_FACTOR=1.15
# Shared local throttle for all provider processes. It coordinates parallel
# lanes without retaining credentials or response content.
LLM_THROTTLE_DIR=.llm-rate-limit
LLM_MIN_REQUEST_INTERVAL_SECONDS=0.25
LLM_RATE_LIMIT_SAFETY_RATIO=0.8

# Pipeline controls used by the corresponding stages. Explicit command-line
# options override these values. Extraction-lane handwriting is comment-only;
# the separate HTR amendment lane remains review-gated.
HANDWRITING_POLICY=comment_only
ARITHMETIC_TOLERANCE=0.01
ARITHMETIC_DEFER_UNASSIGNED_PAGES=false
COMPLETENESS_DATE_ORDER=month_first
COMPLETENESS_BLOCK_ON_UNANALYZED_POPULATION=false
REASSEMBLY_BROAD_UNORDERED_PROPOSALS=false
PREPROCESS_DPI=300
ANALYTICS_ENABLED=true

# Optional source-native table comprehension (disabled until invoked). The same
# model's profile, extraction, and audit roles are not independent consensus.
TABLE_COMPREHENSION_REASONING_EFFORT=medium
TABLE_COMPREHENSION_CREDENTIAL_ENV=OPENAI_API_KEY
TABLE_COMPREHENSION_TIMEOUT_SECONDS=120
TABLE_COMPREHENSION_MAX_RETRIES=2
TABLE_COMPREHENSION_MAX_PAGES=500
TABLE_COMPREHENSION_CLIENT_CONTEXT_MAX_BYTES=500000
TABLE_COMPREHENSION_REFINEMENT_PASSES=3
TABLE_COMPREHENSION_REFINEMENT_TOLERANCE=0
# Reuse the immutable initial source-profile packet during a refinement reread,
# so each reread makes only rows and audit LLM PDF calls. Set false only for a
# separately approved full reprofiling experiment.
TABLE_COMPREHENSION_REFINEMENT_REUSE_PROFILE=true
TABLE_COMPREHENSION_MAPPING_MIN_CONFIDENCE=0.99
# --propose-mappings creates client-review proposals only. A model proposal can
# never be applied until a client-approved append-only registry update exists.
# Refinement rereads only uncertain pages against later source-layout context.
# It stops when the candidate set is stable within the tolerance or at its hard
# pass limit; it creates amendment proposals and never overwrites first readings.

# Google Document AI (disabled by default; proposal-only independent OCR/table evidence).
# Its REST API requires an OAuth access token, not a browser/API key.
GOOGLE_DOCUMENT_AI_ENABLED=false
# There is deliberately no token setting: the lane mints a short-lived token from
# Application Default Credentials at run time via scripts/reauthorize_google.py.
# Run that once per session. An exported GOOGLE_DOCUMENT_AI_ACCESS_TOKEN in the run
# shell (CI or a secret manager) still takes precedence. Never store a token here.
GOOGLE_DOCUMENT_AI_CREDENTIAL_ENV=GOOGLE_DOCUMENT_AI_ACCESS_TOKEN
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_VERSION=
GOOGLE_DOCUMENT_AI_MAX_PAGES=1000
GOOGLE_DOCUMENT_AI_MAX_PDF_BYTES=10000000
GOOGLE_DOCUMENT_AI_TIMEOUT_SECONDS=180
GOOGLE_DOCUMENT_AI_NATIVE_PDF_PARSING=false
# Invoke only after client privacy approval and processor acceptance. It never
# applies mappings or final financial/identity facts automatically.

# Google Cloud Vision handwriting OCR (disabled by default; proposal-only HTR
# vote). The service OCRs every retained page with DOCUMENT_TEXT_DETECTION and
# binds words only to separately detected handwriting regions. It uses the same
# Application Default Credentials as Document AI — one scripts/reauthorize_google.py
# run enables both APIs — and mints its token at run time, so there is deliberately
# no token setting here.
GOOGLE_HANDWRITING_OCR_ENABLED=false
GOOGLE_HANDWRITING_OCR_CREDENTIAL_ENV=GOOGLE_HANDWRITING_OCR_ACCESS_TOKEN
GOOGLE_HANDWRITING_OCR_PROJECT_ID=
GOOGLE_HANDWRITING_OCR_LOCATION=us
GOOGLE_HANDWRITING_OCR_LANGUAGE_HINTS=en-t-i0-handwrit
GOOGLE_HANDWRITING_OCR_MAX_PAGES=1000
GOOGLE_HANDWRITING_OCR_MAX_PDF_BYTES=10000000
GOOGLE_HANDWRITING_OCR_MAX_IMAGE_BYTES=20000000
GOOGLE_HANDWRITING_OCR_TIMEOUT_SECONDS=180
GOOGLE_HANDWRITING_OCR_MAX_RETRIES=2
GOOGLE_HANDWRITING_OCR_RENDER_DPI=300
# Source GOOGLE_HANDWRITING_OCR_ACCESS_TOKEN from the temporary 0600 file
# produced by scripts/reauthorize_google.py. Never store it in this file.

# Optional TLS-only read-only retrieval API. Keep disabled unless a client has
# approved the bind host, certificate/private-key paths, and secret distribution.
RETRIEVAL_HTTPS_ENABLED=false
RETRIEVAL_HTTPS_BEARER_TOKEN=
RETRIEVAL_HTTPS_CREDENTIAL_ENV=RETRIEVAL_HTTPS_BEARER_TOKEN
RETRIEVAL_REMOTE_MCP_ENABLED=false
RETRIEVAL_REMOTE_MCP_CLIENT_SECRET=
# Optional internal sidecar retrieval API for a co-located app or ECS task.
# Use either a direct SQLite path or a directory containing business_retrieval.sqlite.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
RETRIEVAL_DB_URL=
RETRIEVAL_ARTIFACT_ROOT=

# Canonical PostgreSQL deployment (used only by scripts/canonical_deploy.py --execute).
CANONICAL_DATABASE_URL=
# Keep blank until an authorized deployment environment is selected. The deployment plan records only this variable name, never its value.

# Optional LLM adjudication (disabled by default; proposals always require client review).
LLM_ADJUDICATION_ENABLED=false
LLM_ADJUDICATION_REASONING_EFFORT=medium
LLM_ADJUDICATION_CREDENTIAL_ENV=OPENAI_API_KEY
LLM_ADJUDICATION_MIN_CONFIDENCE=0.99
LLM_ADJUDICATION_SAMPLING_RATE=1.0
LLM_ADJUDICATION_MAX_CANDIDATES=500
LLM_ADJUDICATION_MAX_PDF_BYTES=10000000
LLM_ADJUDICATION_TIMEOUT_SECONDS=120
LLM_ADJUDICATION_MAX_RETRIES=2
# Only explicit candidates that passed deterministic validation and agree with an
# independent extractor are queried. Financial/address/handwriting/reassembly
# candidates and any disagreement stay in client review regardless of this threshold.

# Optional card-level client-review assistant (disabled by default; proposal-only).
CLIENT_REVIEW_LLM_ENABLED=false
LLM_CLIENT_REVIEW_PROVIDER=
# Provider for post-review cross-record and full-dataset lanes. Blank inherits
# the client-review/reasoning provider. Its reasoning model is selected
# automatically; there is no separate post-review model setting.
LLM_POST_REVIEW_PROVIDER=
CLIENT_REVIEW_LLM_MODEL=
CLIENT_REVIEW_LLM_REASONING_EFFORT=medium
CLIENT_REVIEW_LLM_CREDENTIAL_ENV=
CLIENT_REVIEW_LLM_RETRY_BACKOFF_SECONDS=1.0
CLIENT_REVIEW_LLM_MAX_BACKOFF_SECONDS=120.0
CLIENT_REVIEW_LLM_MAX_RETRIES=4
CLIENT_REVIEW_LLM_MAX_WORKERS=8
CLIENT_REVIEW_LLM_MAX_CARDS=1000
CLIENT_REVIEW_LLM_MAX_CONTEXT_BYTES=20000
CLIENT_REVIEW_LLM_TIMEOUT_SECONDS=120.0
CLIENT_REVIEW_LLM_AUTO_ACCEPT_PROPOSALS=false
CLIENT_REVIEW_LLM_AUTO_ACCEPT_THRESHOLD=0.99
# Allows source-backed next-step proposals for protected arithmetic/reassembly
# findings in a final review. They remain review-required and never auto-accepted.
CLIENT_REVIEW_LLM_FINAL_RUN_INCLUDE_PROTECTED_ARITHMETIC_REASSEMBLY=false
CLIENT_REVIEW_CROSS_RECORD_MAX_WORKERS=8
CLIENT_REVIEW_LLM_CROSS_RECORD_ENABLED=false
# Cross-record analysis is split into bounded requests. The per-artifact context
# cap, total serialized packet cap, review-item count cap, evidence-artifact
# byte cap, and total evidence-entry cap are independent safety controls;
# successful batches are retained if another batch fails.
CLIENT_REVIEW_LLM_CROSS_RECORD_MAX_CONTEXT_BYTES=12000
CLIENT_REVIEW_LLM_CROSS_RECORD_MAX_PACKET_BYTES=600000
CLIENT_REVIEW_LLM_CROSS_RECORD_MAX_ITEMS_PER_BATCH=150
CLIENT_REVIEW_LLM_CROSS_RECORD_MAX_EVIDENCE_ARTIFACT_BYTES=10000000
CLIENT_REVIEW_LLM_CROSS_RECORD_MAX_EVIDENCE_ENTRIES=10000
# Repeatable post-review consolidation: cross-record evidence, full-dataset
# contradiction analysis, dependency grouping, exact duplicate presentation
# collapse, and optional low-risk carry-forward. This never approves facts.
CLIENT_REVIEW_LLM_SAFE_CONSOLIDATION_ENABLED=false
CLIENT_REVIEW_LLM_SAFE_CONSOLIDATION_CARRY_FORWARD=false
CLIENT_REVIEW_LLM_SAFE_CONSOLIDATION_THRESHOLD=0.99
CLIENT_REVIEW_LLM_SAFE_CONSOLIDATION_OUTPUT_DIR=post_review_consolidation
CLIENT_REVIEW_LLM_SAFE_CONSOLIDATION_OUTPUT_FILE=safe_review_consolidation.json
# Proposal-only root-cause grouping for template families, repeated provider
# disagreements, and client-approved batch-rule candidates. It never deletes
# queue items or approves facts.
CLIENT_REVIEW_GROUPING_ENABLED=false
CLIENT_REVIEW_GROUPING_OUTPUT_FILE=client_review_grouping.json
# Optional full-dataset proposal-only review agent.
CLIENT_REVIEW_LLM_AGENT_MAX_WORKERS=8
CLIENT_REVIEW_LLM_AGENT_ITERATIONS=3
# Retained-inventory size guard. Provider requests use the bounded slice
# settings below; the complete evidence inventory is always retained in output.
CLIENT_REVIEW_LLM_AGENT_MAX_CONTEXT_BYTES=3500000
# The complete evidence inventory remains retained, while provider requests use
# bounded slices so one oversized packet cannot suppress the entire analysis.
CLIENT_REVIEW_LLM_AGENT_MAX_SLICE_CONTEXT_BYTES=2000000
CLIENT_REVIEW_LLM_AGENT_MAX_EVIDENCE_PER_SLICE=5000
# Optional AI simulated-client review companion. This is disabled by default
# and produces comments for real client/operator review only; it can never
# become client authorization, apply a decision, clear a control, or stage CRM.
AI_SIMULATED_CLIENT_REVIEW_MAX_WORKERS=8
AI_SIMULATED_CLIENT_REVIEW_ENABLED=false
AI_SIMULATED_CLIENT_REVIEW_PROVIDER=openai
AI_SIMULATED_CLIENT_REVIEW_MODEL=gpt-5.6-luna
AI_SIMULATED_CLIENT_REVIEW_CREDENTIAL_ENV=
AI_SIMULATED_CLIENT_REVIEW_REASONING_EFFORT=high
AI_SIMULATED_CLIENT_REVIEW_TIMEOUT_SECONDS=300
AI_SIMULATED_CLIENT_REVIEW_MAX_RETRIES=2
AI_SIMULATED_CLIENT_REVIEW_RETRY_BACKOFF_SECONDS=5.0
AI_SIMULATED_CLIENT_REVIEW_MAX_BACKOFF_SECONDS=180.0
# Zero reviews every retained card. A positive number is an explicit cost cap;
# every deferred card remains in the companion exception artifact.
AI_SIMULATED_CLIENT_REVIEW_MAX_CARDS=0
AI_SIMULATED_CLIENT_REVIEW_MAX_CONTEXT_BYTES=2000000
AI_SIMULATED_CLIENT_REVIEW_MAX_CONTEXT_ARTIFACT_BYTES=10000000
AI_SIMULATED_CLIENT_REVIEW_CONTEXT_RESERVE_BYTES=16000
AI_SIMULATED_CLIENT_REVIEW_COMMENT_LABEL="AI client reviewed (simulated; not client authorization)"
# Optional client-context reference-discovery lane. It is disabled unless
# explicitly enabled; Google Gemini Pro is the bounded default when enabled.
CLIENT_REVIEW_CONTEXT_LLM_ENABLED=false
CLIENT_REVIEW_CONTEXT_LLM_PROVIDER=google
CLIENT_REVIEW_CONTEXT_LLM_MODEL=gemini-2.5-pro
CLIENT_REVIEW_CONTEXT_LLM_REASONING_EFFORT=medium
CLIENT_REVIEW_CONTEXT_LLM_CREDENTIAL_ENV=
CLIENT_REVIEW_CONTEXT_LLM_TIMEOUT_SECONDS=180
CLIENT_REVIEW_CONTEXT_LLM_MAX_RETRIES=4
CLIENT_REVIEW_CONTEXT_LLM_RETRY_BACKOFF_SECONDS=5.0
CLIENT_REVIEW_CONTEXT_LLM_MAX_BACKOFF_SECONDS=180
CLIENT_REVIEW_CONTEXT_LLM_MAX_DOCUMENTS=75
CLIENT_REVIEW_CONTEXT_LLM_MAX_WORKERS=8
CLIENT_REVIEW_CONTEXT_LLM_BATCH_SIZE=6
CLIENT_REVIEW_CONTEXT_LLM_MAX_BATCHES=12
CLIENT_REVIEW_CONTEXT_LLM_ITERATIVE_MAX_BATCHES=0
CLIENT_REVIEW_CONTEXT_LLM_MAX_CONTEXT_BYTES=120000
CLIENT_REVIEW_CONTEXT_LLM_BUDDY_PROVIDER=openai
CLIENT_REVIEW_CONTEXT_LLM_BUDDY_MODEL=gpt-5.6-sol
CLIENT_REVIEW_CONTEXT_LLM_BUDDY_CREDENTIAL_ENV=
CLIENT_REVIEW_CONTEXT_LLM_BUDDY_TIMEOUT_SECONDS=300
CLIENT_REVIEW_CONTEXT_LLM_MAX_ITERATIONS=3
# Stop an iterative refinement once a pass adds fewer than this many new,
# buddy-confirmed, source-backed relationships. Must be at least 1.
CLIENT_REVIEW_CONTEXT_LLM_CONVERGENCE_MIN_NEW_CANDIDATES=1
# The iterative lane uses Gemini as the primary proposal reviewer and OpenAI as
# a genuinely independent buddy check. Both outputs remain proposal-only.
# Deprecated compatibility settings for the older single-provider discovery CLI.
CLIENT_REVIEW_CONTEXT_LLM_SELF_CHECK_ROUNDS=0
CLIENT_REVIEW_CONTEXT_LLM_OPENAI_MODEL=gpt-5.6-sol
CLIENT_REVIEW_CONTEXT_LLM_OPENAI_TIMEOUT_SECONDS=300
# Optional graph-guided follow-up. It discovers links for documents without an
# in-packet buddy relationship and independently verifies prior relationships
# against source-visible identifiers across packets; every output remains proposal-only.
CLIENT_REVIEW_CROSS_PACKET_PRIMARY_PROVIDER=openai
CLIENT_REVIEW_CROSS_PACKET_PRIMARY_MODEL=gpt-5.6-luna
CLIENT_REVIEW_CROSS_PACKET_PRIMARY_CREDENTIAL_ENV=
CLIENT_REVIEW_CROSS_PACKET_PRIMARY_TIMEOUT_SECONDS=300
CLIENT_REVIEW_CROSS_PACKET_BUDDY_PROVIDER=google
CLIENT_REVIEW_CROSS_PACKET_BUDDY_MODEL=gemini-2.5-pro
CLIENT_REVIEW_CROSS_PACKET_BUDDY_CREDENTIAL_ENV=
CLIENT_REVIEW_CROSS_PACKET_BUDDY_TIMEOUT_SECONDS=180
CLIENT_REVIEW_CROSS_PACKET_REASONING_EFFORT=medium
CLIENT_REVIEW_CROSS_PACKET_MAX_RETRIES=4
CLIENT_REVIEW_CROSS_PACKET_RETRY_BACKOFF_SECONDS=5.0
CLIENT_REVIEW_CROSS_PACKET_MAX_BACKOFF_SECONDS=180
CLIENT_REVIEW_CROSS_PACKET_MAX_DOCUMENTS=6
CLIENT_REVIEW_CROSS_PACKET_MAX_NEIGHBORHOODS=500
CLIENT_REVIEW_CROSS_PACKET_MAX_VERIFICATION_NEIGHBORHOODS=1000
CLIENT_REVIEW_CROSS_PACKET_MAX_CONTEXT_BYTES=80000
# Cross-packet refinement automatically stops early when it has converged; the
# second pass is limited to newly exposed source-visible neighborhoods.
CLIENT_REVIEW_CROSS_PACKET_MAX_ITERATIONS=2
CLIENT_REVIEW_CROSS_PACKET_CONVERGENCE_MIN_NEW_CANDIDATES=1
# Generic primary/buddy exception-resolution proposals; disabled by default.
CLIENT_REVIEW_EXCEPTION_RESOLUTION_ENABLED=false
CLIENT_REVIEW_EXCEPTION_RESOLUTION_PRIMARY_PROVIDER=openai
CLIENT_REVIEW_EXCEPTION_RESOLUTION_PRIMARY_MODEL=gpt-5.6-luna
CLIENT_REVIEW_EXCEPTION_RESOLUTION_PRIMARY_CREDENTIAL_ENV=
CLIENT_REVIEW_EXCEPTION_RESOLUTION_BUDDY_PROVIDER=openrouter
CLIENT_REVIEW_EXCEPTION_RESOLUTION_BUDDY_MODEL=openai/gpt-oss-120b
CLIENT_REVIEW_EXCEPTION_RESOLUTION_BUDDY_CREDENTIAL_ENV=
CLIENT_REVIEW_EXCEPTION_RESOLUTION_REASONING_EFFORT=medium
CLIENT_REVIEW_EXCEPTION_RESOLUTION_TIMEOUT_SECONDS=180
CLIENT_REVIEW_EXCEPTION_RESOLUTION_MAX_RETRIES=2
CLIENT_REVIEW_EXCEPTION_RESOLUTION_RETRY_BACKOFF_SECONDS=5.0
CLIENT_REVIEW_EXCEPTION_RESOLUTION_MAX_BACKOFF_SECONDS=180
CLIENT_REVIEW_EXCEPTION_RESOLUTION_MAX_WORKERS=8
CLIENT_REVIEW_EXCEPTION_RESOLUTION_BATCH_SIZE=6
CLIENT_REVIEW_EXCEPTION_RESOLUTION_MAX_BATCHES=0
CLIENT_REVIEW_EXCEPTION_RESOLUTION_MAX_CONTEXT_BYTES=120000
# This lane can reduce only the client-facing view of explicitly dependent,
# low-risk items. Every source item remains in the retained audit artifact.

# Google Maps Address Validation (disabled by default; client approval required).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_ENV=GOOGLE_MAPS_API_KEY
GOOGLE_ADDRESS_VALIDATION_ENABLED=false
GOOGLE_MAX_REQUESTS=5000
GOOGLE_TIMEOUT_SECONDS=15
GOOGLE_USPS_CASS_ENABLED=true
# Keep GOOGLE_ADDRESS_VALIDATION_ENABLED=false for local-only address parsing.
# If enabled, 1 <= GOOGLE_MAX_REQUESTS <= 5000; every provider attempt counts.
# This is a per-run safeguard, not a billing-account usage monitor; set Cloud budgets separately.

# Client review lane. Turns whatever a blocked control produced into one client
# pack: grouped questions, a workbook to answer in, and an instruction PDF with
# the source page behind each question. It calls no provider and spends nothing,
# which is why it is on by default unlike the provider-calling lanes.
CLIENT_REVIEW_LANE_ENABLED=true
CLIENT_REVIEW_LANE_MAX_QUESTIONS=25
CLIENT_REVIEW_LANE_RENDER_DPI=150
CLIENT_REVIEW_LANE_MAX_IMAGE_BYTES=4000000
# Per-control floors on blocking findings. The lane builds a pack for a control
# only once that control reaches its floor, so it can be run after every stage
# without producing a pack nobody needed. A floor never filters the queue: items
# below it stay in the exhaustive queue and in the run's exceptions either way.
# Raise one deliberately to reduce noise; 0 means the control never triggers a
# pack on its own.
CLIENT_REVIEW_LANE_EXTRACTION_THRESHOLD=1
CLIENT_REVIEW_LANE_CONSENSUS_THRESHOLD=1
CLIENT_REVIEW_LANE_ARITHMETIC_THRESHOLD=1
CLIENT_REVIEW_LANE_VALIDATION_THRESHOLD=1
CLIENT_REVIEW_LANE_ADJUDICATION_THRESHOLD=1
CLIENT_REVIEW_LANE_REASSEMBLY_THRESHOLD=1
CLIENT_REVIEW_LANE_TABLES_THRESHOLD=1
CLIENT_REVIEW_LANE_HANDWRITING_THRESHOLD=1
CLIENT_REVIEW_LANE_IDENTITY_THRESHOLD=1
CLIENT_REVIEW_LANE_ATTRIBUTION_THRESHOLD=1
CLIENT_REVIEW_LANE_COMPLETENESS_THRESHOLD=1
CLIENT_REVIEW_LANE_SAMPLING_THRESHOLD=1
CLIENT_REVIEW_LANE_SCHEMA_THRESHOLD=1
CLIENT_REVIEW_LANE_SLOT_EQUIVALENCE_THRESHOLD=1
CLIENT_REVIEW_LANE_ALLOCATION_THRESHOLD=1
CLIENT_REVIEW_LANE_RELATIONSHIPS_THRESHOLD=1
CLIENT_REVIEW_LANE_DELIVERY_THRESHOLD=1

# Optional semantic schema discovery (disabled by default; all outputs require client review).
SCHEMA_DISCOVERY_ENABLED=false
SCHEMA_DISCOVERY_PROVIDER=google
SCHEMA_DISCOVERY_MODEL=gemini-2.5-pro
SCHEMA_DISCOVERY_REASONING_EFFORT=medium
SCHEMA_DISCOVERY_CREDENTIAL_ENV=
SCHEMA_DISCOVERY_MIN_CONFIDENCE=0.99
SCHEMA_DISCOVERY_TIMEOUT_SECONDS=120
SCHEMA_DISCOVERY_MAX_RETRIES=2
SCHEMA_DISCOVERY_BUDDY_ENABLED=true
SCHEMA_DISCOVERY_BUDDY_PROVIDER=openai
SCHEMA_DISCOVERY_BUDDY_MODEL=gpt-5.6-luna
SCHEMA_DISCOVERY_BUDDY_CREDENTIAL_ENV=
SCHEMA_DISCOVERY_BUDDY_TIMEOUT_SECONDS=120
SCHEMA_DISCOVERY_BUDDY_MAX_RETRIES=2
# Optional schema-slot equivalence (disabled by default; all outputs require client review).
# Proposes that two controlled fields are one business fact for this client, from
# consensus evidence in which the identical value reached two different slots.
SLOT_EQUIVALENCE_ENABLED=false
SLOT_EQUIVALENCE_PROVIDER=google
SLOT_EQUIVALENCE_MODEL=gemini-2.5-pro
SLOT_EQUIVALENCE_REASONING_EFFORT=medium
SLOT_EQUIVALENCE_CREDENTIAL_ENV=
SLOT_EQUIVALENCE_MIN_CONFIDENCE=0.99
SLOT_EQUIVALENCE_MIN_OBSERVATIONS=2
SLOT_EQUIVALENCE_MIN_DISTINCT_VALUES=2
SLOT_EQUIVALENCE_TIMEOUT_SECONDS=120
SLOT_EQUIVALENCE_MAX_RETRIES=2
SLOT_EQUIVALENCE_BUDDY_ENABLED=true
SLOT_EQUIVALENCE_BUDDY_PROVIDER=openai
SLOT_EQUIVALENCE_BUDDY_MODEL=gpt-5.6-luna
SLOT_EQUIVALENCE_BUDDY_CREDENTIAL_ENV=
SLOT_EQUIVALENCE_BUDDY_TIMEOUT_SECONDS=120
SLOT_EQUIVALENCE_BUDDY_MAX_RETRIES=2
# MIN_DISTINCT_VALUES separates a real equivalence from one repeated coincidence:
# a quantity of 1 meeting a line number of 1 repeats a single value, while a
# shared column carries many. A pair with no cross-engine observation rests only
# on one engine using both names and is never approval-eligible.
# Google Places uses a separately restricted key to discover candidate dealer/brand locations; it never selects an address.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY_ENV=GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_MAX_REQUESTS=100
GOOGLE_PLACES_TIMEOUT_SECONDS=15
# key sends the restricted key above; adc sends Application Default Credentials.
GOOGLE_PLACES_AUTH=key


# Optional allocation-policy discovery (disabled by default; client decisions create policies).
ALLOCATION_POLICY_ENABLED=false
ALLOCATION_POLICY_REASONING_EFFORT=medium
ALLOCATION_POLICY_CREDENTIAL_ENV=OPENAI_API_KEY
ALLOCATION_POLICY_TIMEOUT_SECONDS=120
ALLOCATION_POLICY_MAX_RETRIES=2
# Thresholds, sales-credit permission, scope dimensions, and effective dates are
# client-approved values in the versioned policy registry, never global .env settings.
